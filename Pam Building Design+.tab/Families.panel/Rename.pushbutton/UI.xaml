<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batch Rename Families"
        Width="600" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual">

  <Window.Resources>

    <!-- BUTTON STYLE -->
    <Style TargetType="Button">
      <Setter Property="TextElement.FontFamily" Value="Source Sans Pro"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="4"
                    Background="#FF3B4559"
                    BorderBrush="#FFDC4405"
                    BorderThickness="1">
              <ContentPresenter VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="12,4"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FFDC4405"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF3B4559"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background" Value="#FF555F72"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF555F72"/>
                <Setter Property="Foreground" Value="#FF8892A4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- TEXTBLOCK STYLE -->
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Source Sans Pro"/>
      <Setter Property="FontSize"   Value="12"/>
      <Setter Property="Foreground" Value="#FF3B4559"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- TEXTBOX STYLE -->
    <Style TargetType="TextBox">
      <Setter Property="FontFamily"  Value="Source Sans Pro"/>
      <Setter Property="FontSize"    Value="12"/>
      <Setter Property="Height"      Value="26"/>
      <Setter Property="Margin"      Value="0,3,0,0"/>
      <Setter Property="Padding"     Value="4,3"/>
      <Setter Property="BorderBrush" Value="#FFBCC0C8"/>
    </Style>

    <!-- COMBOBOX STYLE -->
    <Style TargetType="ComboBox">
      <Setter Property="FontFamily" Value="Source Sans Pro"/>
      <Setter Property="FontSize"   Value="12"/>
      <Setter Property="Height"     Value="26"/>
      <Setter Property="Margin"     Value="0,3,0,0"/>
    </Style>

    <!-- CHECKBOX STYLE -->
    <Style TargetType="CheckBox">
      <Setter Property="FontFamily" Value="Source Sans Pro"/>
      <Setter Property="FontSize"   Value="12"/>
      <Setter Property="Foreground" Value="#FF3B4559"/>
      <Setter Property="Margin"     Value="0,6,0,0"/>
    </Style>

    <!-- LISTBOX STYLE -->
    <Style TargetType="ListBox">
      <Setter Property="FontFamily"      Value="Source Sans Pro"/>
      <Setter Property="FontSize"        Value="12"/>
      <Setter Property="BorderBrush"     Value="#FFBCC0C8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background"      Value="White"/>
    </Style>

    <!-- SECTION LABEL -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Source Sans Pro"/>
      <Setter Property="FontSize"   Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#FF3B4559"/>
      <Setter Property="Margin"     Value="0,10,0,3"/>
    </Style>

    <!-- CARD BORDER -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background"      Value="#FFF5F6F8"/>
      <Setter Property="BorderBrush"     Value="#3B4559"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius"    Value="6"/>
      <Setter Property="Padding"         Value="12,10"/>
      <Setter Property="Margin"          Value="0,0,0,8"/>
    </Style>

    <!-- RENAME CARD (orange accent) -->
    <Style x:Key="RenameCard" TargetType="Border">
      <Setter Property="Background"      Value="#FFFFF3EE"/>
      <Setter Property="BorderBrush"     Value="#3B4559"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius"    Value="6"/>
      <Setter Property="Padding"         Value="12,10"/>
      <Setter Property="Margin"          Value="0,4,0,8"/>
    </Style>

  </Window.Resources>

  <!-- Outer border -->
  <Border Background="#FFEBECEE"
          BorderBrush="#FFDC4405"
          BorderThickness="1.5"
          CornerRadius="10">
    <Grid>

      <!-- Title Bar -->
      <Border x:Name="TitleBar" Background="#FF3B4559"
              Height="36" VerticalAlignment="Top"
              CornerRadius="8.5,8.5,0,0">
        <Grid>
          <TextBlock Text="Batch Rename Families"
                     VerticalAlignment="Center" HorizontalAlignment="Center"
                     FontSize="13" FontWeight="Bold"
                     Foreground="White" TextWrapping="NoWrap"/>
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Right" VerticalAlignment="Center"
                      Margin="0,0,8,0">
            <Button x:Name="btn_minimize" Content="&#x2013;"
                    Height="24" Width="40" FontSize="15"
                    FontWeight="Bold" Margin="0,0,4,0"/>
            <Button x:Name="btn_close" Content="&#x2715;"
                    Height="24" Width="40" FontSize="13"
                    FontWeight="Bold"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Content -->
      <ScrollViewer Margin="0,36,0,0" VerticalScrollBarVisibility="Auto"
                    MaxHeight="860">
        <StackPanel Margin="16,12,16,16">

          <!-- ── LOGO ────────────────────────────────────────────────── -->
          <Image x:Name="logo" Source="https://iili.io/27tnOCB.md.png"
                 HorizontalAlignment="Center" VerticalAlignment="Top"
                 Height="98" Width="166"
                 Margin="0,0,0,6" Cursor="Hand"
                 RenderOptions.BitmapScalingMode="HighQuality"
                 Stretch="Uniform"
                 RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
              <ScaleTransform x:Name="logoScaleTransform"/>
            </Image.RenderTransform>
            <Image.Triggers>
              <EventTrigger RoutedEvent="Image.MouseEnter">
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="logoScaleTransform"
                                        Storyboard.TargetProperty="ScaleX"
                                        To="1.1" Duration="0:0:0.2"/>
                    <DoubleAnimation Storyboard.TargetName="logoScaleTransform"
                                        Storyboard.TargetProperty="ScaleY"
                                        To="1.1" Duration="0:0:0.2"/>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
              <EventTrigger RoutedEvent="Image.MouseLeave">
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="logoScaleTransform"
                                        Storyboard.TargetProperty="ScaleX"
                                        To="1.0" Duration="0:0:0.2"/>
                    <DoubleAnimation Storyboard.TargetName="logoScaleTransform"
                                        Storyboard.TargetProperty="ScaleY"
                                        To="1.0" Duration="0:0:0.2"/>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
            </Image.Triggers>
          </Image>

          <!-- ── FAMILY LIST ─────────────────────────────────────────── -->
          <TextBlock Style="{StaticResource SectionLabel}" Text="Project Families"/>
          <Border Style="{StaticResource Card}">
            <StackPanel>

              <!-- Category filter -->
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Category"
                           Foreground="#FF6B7490"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           Width="60"/>
                <ComboBox x:Name="category_combo" Grid.Column="1"/>
              </Grid>

              <!-- Name filter -->
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Name filter"
                           Foreground="#FF6B7490"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           Width="60"/>
                <TextBox x:Name="filter_box" Grid.Column="1"
                         Height="26" Padding="4,3" Margin="0"/>
              </Grid>

              <!-- Selection helpers -->
              <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                <Button x:Name="btn_select_all"  Content="Select All"
                        Height="22" FontSize="11" Margin="0,0,6,0"/>
                <Button x:Name="btn_select_none" Content="Select None"
                        Height="22" FontSize="11"/>
              </StackPanel>

              <!-- Family list box -->
              <ListBox x:Name="family_list"
                       SelectionMode="Extended"
                       Height="200"/>

              <!-- Selection counter -->
              <TextBlock x:Name="selection_label"
                         Text="0 families selected"
                         Foreground="#FF6B7490"
                         Margin="0,4,0,0"/>
            </StackPanel>
          </Border>

          <!-- ── RENAME: single ─────────────────────────────────────── -->
          <Border x:Name="single_panel" Style="{StaticResource RenameCard}"
                  Visibility="Collapsed">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Foreground="#FFDC4405"
                         Text="Rename &#x2014; single family" Margin="0,0,0,6"/>

              <TextBlock Text="Current name" Foreground="#FF6B7490" Margin="0,0,0,2"/>
              <TextBox x:Name="current_name_box" IsReadOnly="True"
                       Foreground="#FF6B7490" Background="#FFE8E9EC"/>

              <TextBlock Text="New name" Foreground="#FF6B7490" Margin="0,8,0,2"/>
              <TextBox x:Name="new_name_box"/>
            </StackPanel>
          </Border>

          <!-- ── RENAME: multi ──────────────────────────────────────── -->
          <Border x:Name="multi_panel" Style="{StaticResource RenameCard}"
                  Visibility="Collapsed">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Foreground="#FFDC4405"
                         Text="Rename &#x2014; multiple families" Margin="0,0,0,6"/>

              <TextBlock Text="Mode" Foreground="#FF6B7490" Margin="0,0,0,2"/>
              <ComboBox x:Name="mode_combo" SelectedIndex="0">
                <ComboBoxItem>Find &amp; Replace</ComboBoxItem>
                <ComboBoxItem>Add Prefix</ComboBoxItem>
                <ComboBoxItem>Add Suffix</ComboBoxItem>
              </ComboBox>

              <!-- Find & Replace -->
              <StackPanel x:Name="find_replace_panel" Margin="0,8,0,0">
                <TextBlock Text="Find (case-sensitive)" Foreground="#FF6B7490" Margin="0,0,0,2"/>
                <TextBox x:Name="find_box"/>
                <TextBlock Text="Replace with" Foreground="#FF6B7490" Margin="0,8,0,2"/>
                <TextBox x:Name="replace_box"/>
              </StackPanel>

              <!-- Prefix -->
              <StackPanel x:Name="prefix_panel" Visibility="Collapsed" Margin="0,8,0,0">
                <TextBlock Text="Prefix to add" Foreground="#FF6B7490" Margin="0,0,0,2"/>
                <TextBox x:Name="prefix_box"/>
              </StackPanel>

              <!-- Suffix -->
              <StackPanel x:Name="suffix_panel" Visibility="Collapsed" Margin="0,8,0,0">
                <TextBlock Text="Suffix to add" Foreground="#FF6B7490" Margin="0,0,0,2"/>
                <TextBox x:Name="suffix_box"/>
              </StackPanel>

              <!-- Preview -->
              <TextBlock x:Name="preview_label"
                         Foreground="#FF6B7490"
                         FontStyle="Italic"
                         Margin="0,10,0,0"
                         TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <!-- ── BUTTONS ────────────────────────────────────────────── -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                      Margin="0,6,0,0">
            <Button x:Name="btn_cancel" Content="Cancel" IsCancel="True"
                    Margin="0,0,8,0" Height="28" Width="80"/>
            <Button x:Name="ok_btn" Content="Rename"
                    IsDefault="True"
                    Height="28" Width="100" IsEnabled="False"/>
          </StackPanel>

        </StackPanel>
      </ScrollViewer>

    </Grid>
  </Border>
</Window>
